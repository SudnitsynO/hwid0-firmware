template <class MOSI, class MISO, class SCLK, class CS>
void CC1101<MOSI, MISO, SCLK, CS>::rf_init(RegValue * register_list, size_t count)
{
    MOSI::Init();
    MISO::Init();
    SCLK::Init();
    CS::Init();
    MOSI::SetMode(Mode::Output);
    MISO::SetMode(Mode::Input);
    SCLK::SetMode(Mode::Output);
    CS::SetMode(Mode::Output);

    MISO::DisableInterrupt();
    for (size_t i = 0; i < count; i++)
    {
        write_reg(register_list[i].first, register_list[i].second);
    }
    //read_reg(0x20);
}

template <class MOSI, class MISO, class SCLK, class CS> void CC1101<MOSI, MISO, SCLK, CS>::wait_for_idle()
{

    for (int n = 0; n < 1000; n++)
    {
        send_cmd(Commands::SIDLE);
        if ((state & 0x70) == 0)
            break;
        Delay_ms(1);
    }
}

template <class MOSI, class MISO, class SCLK, class CS> bool CC1101<MOSI, MISO, SCLK, CS>::rx_buf(uint32_t timeout)
{
    data_len = 0;
    // send_cmd(Commands::SIDLE);
    wait_for_idle();
    send_cmd(Commands::SFRX);
    send_cmd(Commands::SRX);
    // xSemaphoreTake(miso_falling, 0);
    if (wait_miso(timeout))
    {
        //����� ������
        int n = read_reg(0x3F); // 3b
        if ((n > 0))
        {
            while ((n != 0) && (data_len < 64))
            {
                buffer[data_len] = read_reg(0x3F);
                data_len++;
                n--;
            }
            const int r = read_reg(0x3F);
            if (r >= 128)
            {
                RSSI = (r - 256) / 2.0 - 74;
            }
            else
            {
                RSSI = r / 2.0 - 74;
            }
            LIQ = read_reg(0x3F);
            if (LIQ & 0x80)
            {
                //	freqest += ReadReg(0x32);
                //	WriteReg(0x0C, (signed int)(freqest / 100));
            }
            LIQ &= 0x7F;
            send_cmd(Commands::SFRX);
            send_cmd(Commands::SIDLE);
            return true;
        }
    }
    send_cmd(Commands::SIDLE);
    return false;
}

template <class MOSI, class MISO, class SCLK, class CS> bool CC1101<MOSI, MISO, SCLK, CS>::tx_buf(uint32_t timeout)
{
    // send_cmd(Commands::SIDLE);
    wait_for_idle();
    send_cmd(Commands::SFRX);
    send_cmd(Commands::SFTX);

    if (data_len > 50)
        return false;
    write_reg(0x3F, data_len);
    for (int i = 0; i < data_len; i++)
    {
        write_reg(0x3F, buffer[i]);
    }
    send_cmd(Commands::STX);
    wait_miso(timeout);
    send_cmd(Commands::SFTX);
    send_cmd(Commands::SIDLE);
    return true;
}

template <class MOSI, class MISO, class SCLK, class CS> void CC1101<MOSI, MISO, SCLK, CS>::miso_falling_isr()
{
    static BaseType_t xHigherPriorityTaskWoken;
    xHigherPriorityTaskWoken = pdFALSE;
    xSemaphoreGiveFromISR(miso_falling_semaphore, &xHigherPriorityTaskWoken);
    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
    MISO::DisableInterrupt();
}
